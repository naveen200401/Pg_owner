# Copy this file to a new file named exactly  .env  (no .txt) and fill in the values.
# Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# The owner's login (only this email + password can log in)
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=use-a-long-password-here
# Any long random text (see README steps)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: email for "Forgot password" (Resend). Sign up at resend.com with the SAME email as OWNER_EMAIL.
# Without it, the reset link is printed in the server log instead of emailed.
RESEND_API_KEY=
# Your site address, used inside the reset email (Render fills this in automatically)
PUBLIC_URL=http://localhost:3000
